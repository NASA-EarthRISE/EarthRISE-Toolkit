# Copy this file to .env and fill in the values for your environment.

SECRET_KEY=change-me-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=science.data.nasa.gov

# Sub-path deployment (e.g. /earthrise-toolkit in production, empty for local dev)
# Leave empty when running locally; set to /earthrise-toolkit on the NASA proxy.
SCRIPT_NAME=/earthrise-toolkit

# Required for Django 4.0+ HTTPS POST requests (login, logout, forms).
# Comma-separated list of full scheme+host origins.
CSRF_TRUSTED_ORIGINS=https://science.data.nasa.gov
